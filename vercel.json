{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/manus-storage/:path*", "destination": "/api/storage/:path*" },
    { "source": "/:path((?!api(?:/|$)|media(?:/|$)).*)", "destination": "/index.html" }
  ]
}
